# Agentcity placement contracts. Copy to .env (never committed) and fill in.
# forge reads this file automatically when run from the repository root.

# --- Network: Robinhood Chain ----------------------------------------------------
# JSON-RPC endpoint (used as --rpc-url deploy).
#   testnet  https://rpc.testnet.chain.robinhood.com   chain id 46630
#   mainnet  https://rpc.mainnet.chain.robinhood.com   chain id 4663
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Blockscout explorer API, for --verify. No API key is needed.
#   testnet  https://explorer.testnet.chain.robinhood.com/api/
#   mainnet  https://robinhoodchain.blockscout.com/api/
VERIFIER_URL=https://explorer.testnet.chain.robinhood.com/api/

# --- Deployer (Agentcity developers only) -------------------------------------
# Private key of the wallet that pays gas and deploys. This file never leaves
# a developer's machine and is git-ignored; never put it in the root .env,
# on a server, or in CI. Leave it empty to sign with a Foundry keystore
# instead (cast wallet import deployer --interactive, then --account deployer).
DEPLOYER_PRIVATE_KEY=

# --- Placements collection ---------------------------------------------------
# Multisig that owns both contracts after deploy (it calls acceptOwnership()).
PLACEMENTS_ADMIN=
# Receives every minted token, the protocol fee and royalties.
PLACEMENTS_TREASURY=
# Fixed supply, minted to the treasury at deploy. Downtown: 46.
PLACEMENTS_SUPPLY=46
# Royalty on secondary sales, in basis points (500 = 5%, max 1000).
PLACEMENTS_ROYALTY_BPS=500
# Only for DeployCityCollection (another city's collection).
PLACEMENTS_NAME="Agentcity Placements"
PLACEMENTS_SYMBOL=ACPL

# --- Marketplace ---------------------------------------------------------------
# Protocol fee on every trade, in basis points (250 = 2.5%, max 500).
MARKET_FEE_BPS=250
# USDG token address on this chain (optional).
USDG_ADDRESS=
# More ERC-20s to accept, comma-separated: the town token, partner tokens (optional).
TOKEN_CURRENCIES=

# --- Listing (script/ListPlacements.s.sol) ---------------------------------------
# Deployed addresses (testnet: deployments/robinhood-testnet.json).
PLACEMENTS_CONTRACT_ADDRESS=
PLACEMENTS_MARKET_ADDRESS=
# Key of the wallet holding the tokens (the treasury). Developers only.
LISTER_PRIVATE_KEY=
LIST_FROM=5
LIST_TO=46
LIST_PRICE_WEI=1000000000000000
LIST_DAYS=365
